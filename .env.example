# === GDAS: contrato de credencial do forge (placeholders — NAO commitar valores) ===
# Chaves padrao da capability de ESCRITA no forge (abrir demanda/MR pela API),
# usadas quando a espinha issue->branch->MR precisa CRIAR registros. Doutrina:
# secao "Escrita no forge" do AGENTS.md; mapeamento concreto (CLI/API por forge)
# em docs/adapters.md. O agente rascunha e recomenda; a abertura e aprovada pelo
# humano — nunca efeito colateral direto.
#
# GDAS_FORGE_USER   usuario a quem ATRIBUIR o registro (issue/MR/comentario);
#                   permite alternar de forma explicita e rastreavel, sem
#                   depender de qual credencial esta cacheada no git.
# GDAS_FORGE_TOKEN  token de escrita com escopo `api`. NAO e o token de push do
#                   git (OAuth git-only nao serve a API) nem o token de CI.
#                   Segredo: so aqui, nunca versionado.
#
# Este .env.example e o CONTRATO versionado (placeholders vazios). O .env real
# com os valores e gitignorado pelo piso de segredo (DEC-033) e modo 600.
GDAS_FORGE_USER=
GDAS_FORGE_TOKEN=
# === GDAS: fim do contrato de credencial do forge ===

# === Aplicacao — contrato de variaveis de ambiente ===
# ESTE ARQUIVO E VERSIONADO E SO CONTEM PLACEHOLDERS VAZIOS.
# Copie para .env.local (gitignorado) e preencha la. Nenhum valor real de
# chave pode entrar aqui nem em qualquer arquivo do repositorio.
#
# NENHUMA destas variaveis e necessaria para `npm run build` ou
# `npm run lint` hoje: lib/data/* usa dados mock e os clientes Supabase sao
# criados sob demanda (lazy). Elas passam a ser obrigatorias quando a
# integracao real for ligada.

# --- Supabase (banco, auth do painel admin, storage de imagens) ---
# URL do projeto, ex.: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave anonima. E publica por design e SO e segura com RLS ativa em todas
# as tabelas. Vai para o bundle do browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico: IGNORA RLS. Segredo de servidor — nunca prefixar com
# NEXT_PUBLIC_, nunca importar em componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar (Fase C, issue #36 — agenda pessoal da doutora) ---
# OAuth Client "Web application" no Google Cloud Console. Redirect URIs a
# cadastrar la: http://localhost:3000/admin/agenda/google/callback (dev) e
# https://clinica-site.augustoneonvazryba.workers.dev/admin/agenda/google/callback
# (producao). Client Secret e segredo de servidor — mesmo tratamento do
# SUPABASE_SERVICE_ROLE_KEY acima.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudflare Turnstile (anti-spam do formulario de contato) ---
# Ainda nao criado. Revisao da decisao anterior (issue #51): Turnstile
# aceita qualquer hostname, INCLUSIVE *.workers.dev -- nao precisa mais
# esperar dominio proprio para criar o widget. Passos: Cloudflare
# Dashboard -> Turnstile -> Add site -> hostname atual
# (clinica-site.augustoneonvazryba.workers.dev) -> copiar as duas chaves
# abaixo. O codigo (app/contato/actions.ts, ContactForm.tsx) ja liga
# sozinho assim que as duas existirem, sem precisar editar nada.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-mail transacional (notificar a clinica de novo contato) ---
# Resend ou Cloudflare Email Routing (PLANEJAMENTO.md secao 4).
RESEND_API_KEY=
# Remetente e destinatario das notificacoes de novo lead.
CONTACT_NOTIFICATION_FROM=
CONTACT_NOTIFICATION_TO=

# --- Site ---
# URL publica canonica, usada em metadata/SEO. Ex.: https://exemplo.com.br
NEXT_PUBLIC_SITE_URL=
# === Fim do contrato de variaveis da aplicacao ===
