{
  // Config do Worker de producao (adaptador @opennextjs/cloudflare).
  // Ver AGENTS.md "Decisoes fechadas" (2026-08-04) para o porque da troca
  // Vercel -> Cloudflare Workers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clinica-site",
  "main": ".open-next/worker.js",
  // >= 2025-04-01 e obrigatorio para process.env funcionar em runtime.
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Logs do Worker guardados no painel da Cloudflare (issue #75): o
  // travamento de 2026-09-25 so deu para investigar com `wrangler tail`
  // ao vivo. O codigo nunca loga dado pessoal (regra do AGENTS.md), entao
  // o que fica guardado e request/status/erro, nao conteudo de formulario.
  "observability": {
    "enabled": true
  }
  // Sem kv_namespaces/r2_buckets de proposito: nenhuma pagina usa
  // revalidate/ISR hoje (grep confirmado em app/**). Adicionar cache
  // incremental (R2) so quando isso passar a ser verdade.
}
